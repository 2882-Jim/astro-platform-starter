---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CommitteeGrid from '../../components/CommitteeGrid.astro';
---

<Layout title="Committee" description="The 2026/27 MCASS committee.">
    <Breadcrumbs trail={[{ label: 'Committee' }]} />
    <section class="section">
        <div class="container-site">
            <h1>Meet the committee</h1>
            <p class="mt-4 max-w-2xl text-lg text-stone-600">Trainee accountants from firms across Manchester, elected at our AGM.</p>
            <div class="reveal mt-10"><CommitteeGrid /></div>
        </div>
    </section>
</Layout>
