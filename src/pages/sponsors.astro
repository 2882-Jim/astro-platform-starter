---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import site from '../data/site.json';
import sp from '../data/sponsorship.json';
import { getActiveSponsors } from '../lib/format';

const sponsors = await getActiveSponsors();
// Only say "+ VAT" once the treasurer has confirmed the society is VAT-registered.
const vatSuffix = sp.vatStatus === 'registered' ? ' + VAT' : '';
const mailto = `mailto:${site.sponsorshipEmail}?subject=${encodeURIComponent('Sponsorship enquiry')}`;
---

<Layout title="Partner with us" description="Sponsorship packages for firms who want to reach ACA trainees in Greater Manchester.">
    <section class="bg-navy-900 text-white">
        <div class="container-site grid items-center gap-10 py-16 lg:grid-cols-2">
            <div>
                <p class="eyebrow text-gold-400">Sponsorship</p>
                <h1 class="mt-3 text-white">Partner with MCASS</h1>
                <p class="mt-5 text-lg text-navy-100">{sp.intro}</p>
                <div class="mt-8 flex flex-wrap gap-3">
                    <a href={mailto} class="btn-primary">Request the prospectus</a>
                    {sp.prospectusUrl && <a href={sp.prospectusUrl} class="btn-outline text-white">Download prospectus (PDF)</a>}
                </div>
            </div>
            <Photo alt="Sponsor stand or banner at an MCASS event" label="Sponsor branding at the Annual Ball" />
        </div>
    </section>

    <section class="border-b border-slate-200 bg-navy-50">
        <dl class="container-site grid grid-cols-2 gap-6 py-10 text-center md:grid-cols-4">
            {
                site.stats.map((s) => (
                    <div class="flex flex-col">
                        <dt class="order-2 text-sm text-slate-600">{s.label}</dt>
                        <dd class="text-3xl font-extrabold text-navy-800">{s.value}</dd>
                    </div>
                ))
            }
        </dl>
    </section>

    <section class="section">
        <div class="container-site">
            <p class="eyebrow">Packages</p>
            <h2 class="mt-2">Annual partnership tiers</h2>
            <p class="mt-3 max-w-2xl text-slate-600">All partnerships run for {sp.contractLength}. Every package can be tailored.</p>
            {
                !sp.pricesConfirmed && (
                    <p class="mt-4 inline-block rounded-lg bg-gold-300/60 px-3 py-2 text-sm text-navy-900">
                        Draft prices, subject to committee approval.
                    </p>
                )
            }
            <div class="mt-10 grid gap-6 lg:grid-cols-3">
                {
                    sp.tiers.map((t) => (
                        <div class:list={['card flex flex-col', t.featured && 'border-2 border-gold-400 ring-4 ring-gold-300/30']}>
                            {t.featured && <p class="mb-3 self-start rounded-full bg-gold-400 px-3 py-1 text-xs font-bold text-navy-900">Lead partner</p>}
                            <h3 class="text-xl">{t.name}</h3>
                            <p class="mt-2 text-3xl font-extrabold text-navy-800">
                                {t.price}
                                <span class="text-base font-semibold text-slate-500">{vatSuffix}</span>
                            </p>
                            <p class="mt-1 text-sm text-gold-600">{t.availability}</p>
                            <p class="mt-4 text-sm text-slate-600">{t.summary}</p>
                            <ul class="mt-5 grow space-y-2 text-sm">
                                {t.benefits.map((b) => (
                                    <li class="flex gap-2">
                                        <span class="text-gold-500" aria-hidden="true">✓</span>
                                        <span>{b}</span>
                                    </li>
                                ))}
                            </ul>
                            <a href={`${mailto}${encodeURIComponent(': ' + t.name)}`} class:list={['mt-6', t.featured ? 'btn-primary' : 'btn-dark']}>
                                Enquire
                            </a>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="section bg-slate-50">
        <div class="container-site">
            <h2>Add-ons</h2>
            <p class="mt-3 text-slate-600">Available on their own or alongside any tier.</p>
            <div class="mt-8 grid gap-4 md:grid-cols-3">
                {
                    sp.addons.map((a) => (
                        <div class="card">
                            <h3>{a.name}</h3>
                            <p class="mt-1 font-bold text-navy-800">
                                {a.price}
                                {a.price.startsWith('From') && vatSuffix}
                            </p>
                            <p class="mt-2 text-sm text-slate-600">{a.summary}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container-site">
            <h2>How it works</h2>
            <ol class="mt-8 grid gap-6 md:grid-cols-4">
                {
                    sp.process.map((step, i) => (
                        <li class="card">
                            <span class="grid h-8 w-8 place-items-center rounded-full bg-navy-800 text-sm font-bold text-white">{i + 1}</span>
                            <h3 class="mt-4">{step.title}</h3>
                            <p class="mt-2 text-sm text-slate-600">{step.text}</p>
                        </li>
                    ))
                }
            </ol>
            <p class="mt-8 max-w-3xl text-sm text-slate-500">
                {site.fullName} is a registered charity in England and Wales (number {site.charityNumber}).
                {sp.vatStatus === 'registered' ? ' Prices exclude VAT.' : ''}
            </p>
        </div>
    </section>

    {
        sponsors.length > 0 && (
            <section class="section bg-slate-50">
                <div class="container-site">
                    <h2>Our current partners</h2>
                    <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                        {sponsors.map((s) => (
                            <li class="card">
                                {s.data.logo && <img src={s.data.logo} alt={s.data.name} class="h-12 w-auto" />}
                                <p class="mt-3 font-semibold">{s.data.name}</p>
                                <p class="text-xs text-gold-600">{s.data.tier}</p>
                                {s.data.blurb && <p class="mt-2 text-sm text-slate-600">{s.data.blurb}</p>}
                            </li>
                        ))}
                    </ul>
                </div>
            </section>
        )
    }

    <section class="bg-navy-900 text-white">
        <div class="container-site py-14 text-center">
            <h2 class="text-white">Let's talk</h2>
            <p class="mt-3 text-navy-100">Email us for the full prospectus, audience figures and availability.</p>
            <a href={mailto} class="btn-primary mt-6">{site.sponsorshipEmail}</a>
        </div>
    </section>
</Layout>
