---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import site from '../data/site.json';
import sp from '../data/sponsorship.json';
import { getActiveSponsors } from '../lib/format';

const sponsors = await getActiveSponsors();
// Only say "+ VAT" once the treasurer has confirmed the society is VAT-registered.
const vat = sp.vatStatus === 'registered' ? ' + VAT' : '';
const mailto = `mailto:${site.sponsorshipEmail}?subject=${encodeURIComponent('Sponsorship enquiry')}`;
---

<Layout title="Sponsorship" description="Sponsorship packages for firms who want to reach ACA students in Greater Manchester.">
    <Hero label="Sponsor branding at the Annual Ball">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/80">{site.displayName}</p>
        <h1 class="mt-4 max-w-3xl text-white">Sponsor MCASS</h1>
        <p class="mt-5 max-w-xl text-lg text-white/85">{sp.intro}</p>
        <a href={mailto} class="btn-primary mt-8">Ask for the sponsor pack</a>
    </Hero>
    <Breadcrumbs trail={[{ label: 'Sponsorship' }]} />

    <section class="section">
        <div class="container-site">
            <h2>Packages</h2>
            {!sp.pricesConfirmed && <p class="mt-3 text-xs text-amber-800">Draft prices, subject to committee approval.</p>}
            <div class="mt-10 grid gap-px bg-ink-100 md:grid-cols-3">
                {
                    sp.tiers.map((t, i) => (
                        <div class:list={['reveal flex flex-col bg-white p-8 transition-shadow duration-300 hover:shadow-xl', i === 0 ? 'border-t-4 border-accent-500' : 'border-t-4 border-transparent hover:border-accent-500']}>
                            <h3 class="text-xl font-bold">{t.name}</h3>
                            <p class="mt-1 text-xs uppercase tracking-[0.12em] text-stone-500">{t.note}</p>
                            <p class="mt-6 text-3xl font-bold text-ink-900">
                                {t.price}
                                <span class="text-sm font-normal text-stone-500">{vat}</span>
                            </p>
                            <ul class="mt-6 grow space-y-3 text-sm text-stone-700">
                                {t.benefits.map((b) => <li class="border-l-2 border-ink-100 pl-3">{b}</li>)}
                            </ul>
                            <a href={`${mailto}${encodeURIComponent(': ' + t.name)}`} class="btn-dark mt-8">Enquire</a>
                        </div>
                    ))
                }
            </div>
            <p class="mt-6 max-w-3xl text-sm text-stone-500">{sp.smallPrint}</p>
        </div>
    </section>

    <section class="pb-14 sm:pb-20">
        <div class="container-site">
            <h2>Sponsors at our events</h2>
            <div class="mt-10">
                <Gallery labels={['Sponsor banner at the Ball', 'Partner speaking at an event', 'Branded table', 'Revision session sponsor', 'Summer Games kit']} />
            </div>
        </div>
    </section>

    {
        sponsors.length > 0 && (
            <section class="section bg-ink-50">
                <div class="container-site">
                    <h2>Current sponsors</h2>
                    <ul class="mt-8 flex flex-wrap items-center gap-10">
                        {sponsors.map((s) => (
                            <li title={s.data.name}>{s.data.logo ? <img src={s.data.logo} alt={s.data.name} class="h-12 w-auto" /> : <span class="font-bold">{s.data.name}</span>}</li>
                        ))}
                    </ul>
                </div>
            </section>
        )
    }

    <section class="bg-accent-500 text-white">
        <div class="container-site flex flex-wrap items-center justify-between gap-6 py-12">
            <div>
                <h2 class="text-white">Get in touch</h2>
                <p class="mt-2 text-white/75">
                    {site.fullName} is a registered charity (number {site.charityNumber}).
                </p>
            </div>
            <a href={mailto} class="btn-light">{site.sponsorshipEmail}</a>
        </div>
    </section>
</Layout>
