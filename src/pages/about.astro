---
import { getEntry } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing src/content/pages/about.md');
const { Content } = await page.render();
---

<Layout title={page.data.title} description={page.data.description ?? undefined}>
    <Hero label="Committee or members group photo">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/80">About</p>
        <h1 class="mt-4 text-white">{page.data.title}</h1>
    </Hero>
    <Breadcrumbs trail={[{ label: 'About' }]} />
    <section class="section">
        <div class="container-site grid gap-12 lg:grid-cols-[3fr_2fr]">
            <div class="prose-site"><Content /></div>
            <div class="grid gap-2">
                <Photo alt="Annual Ball" class="aspect-[4/3]" />
                <Photo alt="Revision session" class="aspect-[4/3]" />
            </div>
        </div>
    </section>
    <section class="bg-accent-500 text-white">
        <div class="container-site flex flex-wrap items-center justify-between gap-6 py-12">
            <div>
                <h2 class="text-white">Meet the committee</h2>
                <p class="mt-2 text-white/85">The trainees running MCASS this year.</p>
            </div>
            <a href="/committee/" class="btn-light">Meet them</a>
        </div>
    </section>
    <section class="section">
        <div class="container-site">
            <h2 id="gallery">Gallery</h2>
            <div class="mt-10"><Gallery labels={['Annual Ball', 'Committee handover', 'Summer Games', 'Post-exam social', 'Networking event']} /></div>
        </div>
    </section>
</Layout>
