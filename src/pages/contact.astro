---
import OfficialLink from '../components/OfficialLink.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
---

<Layout title="Contact" description="Get in touch with MCASS.">
    <Breadcrumbs trail={[{ label: 'Contact' }]} />
    <section class="section">
        <div class="container-site">
            <h1>Contact us</h1>
            <p class="mt-4 text-stone-600">Follow MCASS on <a class="underline" href={site.instagramUrl}>Instagram</a> for news and events.</p>
            <div class="card mt-10 max-w-xl">
                <h2 class="text-2xl">Email us</h2>
                <p class="mt-2 text-stone-600">Events, membership, sponsorship or anything else.</p>
                <a href={`mailto:${site.email}`} class="btn-dark mt-4">{site.email}</a>
            </div>
            <div class="mt-6 grid max-w-3xl gap-4 md:grid-cols-2">
                <OfficialLink kind="icaew" variant="card" />
                <OfficialLink kind="charity" variant="card" />
            </div>
        </div>
    </section>
</Layout>
