---
import OfficialLink from '../components/OfficialLink.astro';
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Logo from '../components/Logo.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import EventCard from '../components/EventCard.astro';
import site from '../data/site.json';
import { getEvents, getActiveSponsors, mailingListHref } from '../lib/format';

const { upcoming, past } = await getEvents();
const showUpcoming = upcoming.length > 0;
const eventList = showUpcoming ? upcoming.slice(0, 3) : past.slice(0, 3);
const sponsors = await getActiveSponsors();
const areas = [
    { title: 'Socials', text: 'Quiz nights, golf and the Christmas party.', photo: 'Quiz night at BOX Deansgate', href: '/events/' },
    { title: 'Fitness', text: 'Run club and discounted Barry\'s classes.', photo: 'Run club or Barry\'s class', href: '/events/' },
    { title: 'The Annual Ball', text: 'Great Gatsby theme in 2026.', photo: 'Annual Ball 2026, The Deansgate Hotel', href: '/events/' }
];
---

<Layout>
    <Hero image={site.heroImage} label="Annual Ball (wide shot)" tall>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/80">{site.displayName}</p>
        <h1 class="mt-4 max-w-3xl text-white">{site.tagline}</h1>
        <p class="mt-5 max-w-xl text-lg text-white/85">{site.intro}</p>
        <div class="mt-8 flex flex-wrap gap-3">
            <a href="/events/" class="btn-primary">View events</a>
            <a href={mailingListHref} class="btn-light">Join our mailing list</a>
        </div>
    </Hero>



    <section class="section pb-0">
        <div class="container-site">
            <h2>Quick links</h2>
            <ul class="mt-8 grid grid-cols-2 gap-px bg-ink-100 md:grid-cols-3 lg:grid-cols-6">
                {
                    [
                        { href: '/events/', title: 'Events', text: "What's on" },
                        { href: '/committee/', title: 'Committee', text: 'Who runs MCASS' },
                        { href: '/join/', title: 'Membership', text: 'How to join' },
                        { href: '/sponsors/', title: 'Sponsorship', text: 'For firms' },
                        { href: '/about/', title: 'About', text: 'Who we are' },
                        { href: '/contact/', title: 'Contact', text: 'Get in touch' }
                    ].map((q) => (
                        <li>
                            <a href={q.href} class="group flex h-full flex-col bg-white p-5 transition-colors duration-300 hover:bg-accent-500">
                                <span class="text-base font-bold text-ink-900 group-hover:text-white">{q.title}</span>
                                <span class="mt-1 text-xs text-stone-500 group-hover:text-white/85">{q.text}</span>
                                <span class="mt-4 text-accent-500 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-white" aria-hidden="true">→</span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <section class="section">
        <div class="container-site reveal">
            <h2>What we do</h2>
            <div class="mt-10 grid gap-2 md:grid-cols-3">
                {
                    areas.map((a) => (
                        <a href={a.href} class="group relative block overflow-hidden">
                            <Photo alt={a.photo} class="aspect-[3/4]" />
                            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 to-transparent p-6 pt-20 text-white">
                                <span class="mb-3 block h-1 w-10 bg-accent-500 transition-all duration-500 group-hover:w-20"></span>
                                <h3 class="text-xl font-bold text-white">{a.title}</h3>
                                <p class="mt-1 text-sm text-white/85">{a.text}</p>
                            </div>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="bg-ink-50">
        <div class="grid lg:grid-cols-2">
            <Photo alt="Committee" label="Committee group photo" class="aspect-[4/3] lg:aspect-auto lg:h-full" />
            <div class="px-4 py-14 sm:px-12 lg:py-20">
                <h2>Run by trainees</h2>
                <p class="mt-5 max-w-lg leading-relaxed text-stone-600">A committee of ACA trainees, elected every year, organises everything we do.</p>
                <p class="mt-4 max-w-lg text-sm text-stone-500">Registered charity in England and Wales: <OfficialLink kind="charity" label={`number ${site.charityNumber}`} /></p>
                <dl class="mt-8 grid max-w-lg grid-cols-2 gap-6">
                    {
                        site.stats.slice(0, 4).map((s) => (
                            <div class="flex flex-col border-t-4 border-accent-500 pt-3">
                                <dt class="order-2 text-xs uppercase tracking-[0.12em] text-stone-500">{s.label}</dt>
                                <dd class="text-2xl font-bold text-ink-900">{s.value}</dd>
                            </div>
                        ))
                    }
                </dl>
                <a href="/about/" class="btn-dark mt-10">About us</a>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container-site reveal">
            <div class="flex flex-wrap items-end justify-between gap-4">
                <div>
                    <h2>{showUpcoming ? 'Upcoming events' : 'Recent events'}</h2>
                </div>
                <a href="/events/" class="text-xs font-bold uppercase tracking-[0.12em] text-ink-900 underline underline-offset-4">All events</a>
            </div>
            {
                eventList.length ? (
                    <div class="mt-10 grid gap-6 md:grid-cols-3">{eventList.map((e) => <EventCard event={e} />)}</div>
                ) : (
                    <p class="mt-8 text-stone-600">Nothing booked yet. Check back soon.</p>
                )
            }
        </div>
    </section>

    <section class="pb-14 sm:pb-20">
        <div class="container-site reveal">
            <h2>Photos</h2>
            <div class="mt-10">
                <Gallery labels={['Annual Ball 2026', 'Quiz night', 'Run club', 'Golf at Pitch', 'Christmas social']} />
            </div>
        </div>
    </section>

    <section class="bg-accent-500 text-white">
        <div class="container-site flex flex-wrap items-center justify-between gap-6 py-12">
            <div>
                <h2 class="text-white">Never miss an event</h2>
                <p class="mt-2 text-white/85">Join the mailing list for event dates and ticket links.</p>
            </div>
            <a href={mailingListHref} class="btn-light">Join our mailing list</a>
        </div>
    </section>

    <section class="border-t border-ink-100 bg-ink-50">
        <div class="container-site py-14">
            <div class="flex flex-wrap items-end justify-between gap-6">
                <div>
                    <h2>Our sponsors</h2>
                </div>
                <a href="/sponsors/" class="btn-dark">Sponsor us</a>
            </div>
            {
                sponsors.length ? (
                    <ul class="mt-10 flex flex-wrap items-center gap-10">
                        {sponsors.map((s) => (
                            <li>
                                <a href={s.data.website ?? '#'} class="block no-underline" title={s.data.name}>
                                    {s.data.logo ? <img src={s.data.logo} alt={s.data.name} class="h-12 w-auto" /> : <span class="font-bold">{s.data.name}</span>}
                                </a>
                            </li>
                        ))}
                    </ul>
                ) : (
                    <div class="mt-10 grid grid-cols-2 gap-2 md:grid-cols-4">
                        {['Headline Partner', 'Event Partner', 'Event Partner', 'Supporter'].map((t) => (
                            <div class="grid h-24 place-items-center bg-white text-xs uppercase tracking-[0.12em] text-stone-400">{t} logo</div>
                        ))}
                    </div>
                )
            }
        </div>
    </section>
</Layout>
