---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Logo from '../components/Logo.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import EventCard from '../components/EventCard.astro';
import site from '../data/site.json';
import { getEvents, getActiveSponsors } from '../lib/format';

const { upcoming } = await getEvents();
const sponsors = await getActiveSponsors();
const areas = [
    { title: 'Exams and revision', text: 'Revision sessions ahead of ACA exam sittings.', photo: 'Revision session', href: '/events/' },
    { title: 'Professional development', text: 'Talks and networking with firms across Greater Manchester.', photo: 'Networking event', href: '/events/' },
    { title: 'Socials and sport', text: 'Post-exam socials, the Summer Games and the Annual Ball.', photo: 'Summer Games', href: '/events/' }
];
---

<Layout>
    <Hero image={site.heroImage} label="Annual Ball (wide shot)" tall>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/80">ICAEW student society · Greater Manchester</p>
        <h1 class="mt-4 max-w-3xl text-white">Supporting ACA students across Greater Manchester</h1>
        <p class="mt-5 max-w-xl text-lg text-white/85">{site.tagline}</p>
        <div class="mt-8 flex flex-wrap gap-3">
            <a href="/events/" class="btn-primary">View events</a>
            <a href="/sponsors/" class="btn-light">Sponsorship</a>
        </div>
    </Hero>

    <section class="border-b border-ink-100">
        <div class="container-site flex flex-wrap items-center justify-between gap-6 py-6">
            <p class="text-xs uppercase tracking-[0.15em] text-stone-500">Representing ACA students under ICAEW training contracts</p>
            <div class="flex items-center gap-6">
                <Logo kind="mcass" size="sm" />
                <Logo kind="icaew" />
                <Logo kind="aca" />
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container-site">
            <p class="eyebrow">What we do</p>
            <h2 class="mt-3">Learn, connect, celebrate</h2>
            <div class="mt-10 grid gap-2 md:grid-cols-3">
                {
                    areas.map((a) => (
                        <a href={a.href} class="group relative block no-underline">
                            <Photo alt={a.photo} class="aspect-[3/4]" />
                            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 to-transparent p-6 pt-20 text-white">
                                <h3 class="text-xl font-bold text-white">{a.title}</h3>
                                <p class="mt-1 text-sm text-white/85">{a.text}</p>
                            </div>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="bg-ink-50">
        <div class="grid lg:grid-cols-2">
            <Photo alt="Committee" label="Committee group photo" class="aspect-[4/3] lg:aspect-auto lg:h-full" />
            <div class="px-4 py-14 sm:px-12 lg:py-20">
                <p class="eyebrow">About MCASS</p>
                <h2 class="mt-3">Run by students, since {site.registeredSince}</h2>
                <p class="mt-5 max-w-lg leading-relaxed text-stone-600">{site.intro}</p>
                <p class="mt-4 max-w-lg text-sm text-stone-500">Registered charity in England and Wales, number {site.charityNumber}.</p>
                <dl class="mt-8 grid max-w-lg grid-cols-2 gap-6">
                    {
                        site.stats.slice(0, 4).map((s) => (
                            <div class="flex flex-col border-t-2 border-accent-500 pt-3">
                                <dt class="order-2 text-xs uppercase tracking-[0.12em] text-stone-500">{s.label}</dt>
                                <dd class="text-2xl font-bold text-ink-900">{s.value}</dd>
                            </div>
                        ))
                    }
                </dl>
                <a href="/about/" class="btn-dark mt-10">About us</a>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container-site">
            <div class="flex flex-wrap items-end justify-between gap-4">
                <div>
                    <p class="eyebrow">Events</p>
                    <h2 class="mt-3">Forthcoming events</h2>
                </div>
                <a href="/events/" class="text-xs font-bold uppercase tracking-[0.12em] text-ink-900 underline underline-offset-4">All events</a>
            </div>
            {
                upcoming.length ? (
                    <div class="mt-10 grid gap-6 md:grid-cols-3">{upcoming.slice(0, 3).map((e) => <EventCard event={e} />)}</div>
                ) : (
                    <p class="mt-8 text-stone-600">Forthcoming events will be published here.</p>
                )
            }
        </div>
    </section>

    <section class="pb-14 sm:pb-20">
        <div class="container-site">
            <p class="eyebrow">Gallery</p>
            <h2 class="mt-3">Moments from MCASS</h2>
            <div class="mt-10">
                <Gallery labels={['Annual Ball', 'Summer Games', 'Post-exam social', 'Revision session', 'Awards']} />
            </div>
        </div>
    </section>

    <section class="border-t border-ink-100 bg-ink-50">
        <div class="container-site py-14">
            <div class="flex flex-wrap items-end justify-between gap-6">
                <div>
                    <p class="eyebrow">Our partners</p>
                    <h2 class="mt-3">Supported by</h2>
                </div>
                <a href="/sponsors/" class="btn-dark">Become a partner</a>
            </div>
            {
                sponsors.length ? (
                    <ul class="mt-10 flex flex-wrap items-center gap-10">
                        {sponsors.map((s) => (
                            <li>
                                <a href={s.data.website ?? '#'} class="block no-underline" title={s.data.name}>
                                    {s.data.logo ? <img src={s.data.logo} alt={s.data.name} class="h-12 w-auto" /> : <span class="font-bold">{s.data.name}</span>}
                                </a>
                            </li>
                        ))}
                    </ul>
                ) : (
                    <div class="mt-10 grid grid-cols-2 gap-2 md:grid-cols-4">
                        {['Headline Partner', 'Event Partner', 'Event Partner', 'Supporter'].map((t) => (
                            <div class="grid h-24 place-items-center bg-white text-xs uppercase tracking-[0.12em] text-stone-400">{t} logo</div>
                        ))}
                    </div>
                )
            }
        </div>
    </section>
</Layout>
