---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import EventCard from '../components/EventCard.astro';
import site from '../data/site.json';
import { getEvents, getActiveSponsors, mailingListHref } from '../lib/format';

const { upcoming, past } = await getEvents();
const sponsors = await getActiveSponsors();
// Show upcoming events; if none are booked yet, show the most recent ones.
const showUpcoming = upcoming.length > 0;
const eventList = showUpcoming ? upcoming.slice(0, 3) : past.slice(0, 3);

// Quick links: site pages, ticket links and our official pages, in one place.
// Any upcoming event with a ticket link gets its own "Tickets" tile.
const eventTickets = upcoming
    .filter((e) => e.data.ticketUrl)
    .map((e) => ({ href: e.data.ticketUrl!, title: `Tickets: ${e.data.title}`, external: true }));
const quickLinks = [
    { href: site.ticketsUrl || '/events/', title: 'Buy tickets', external: Boolean(site.ticketsUrl) },
    ...eventTickets,
    { href: '/events/', title: 'Events', external: false },
    { href: '/committee/', title: 'Committee', external: false },
    { href: mailingListHref, title: 'Join our mailing list', external: true },
    { href: '#photos', title: 'Photos', external: false },
    { href: '/sponsors/', title: 'Sponsorship', external: false },
    { href: site.icaewPageUrl, title: 'Our ICAEW page', external: true },
    { href: site.charityRegisterUrl, title: 'Charity register', external: true }
];
const areas = [
    { title: 'Exams and revision', text: 'Revision sessions ahead of ACA exam sittings.', photo: 'Revision session', href: '/events/' },
    { title: 'Professional development', text: 'Talks and networking with firms across Greater Manchester.', photo: 'Networking event', href: '/events/' },
    { title: 'Socials and sport', text: 'Post-exam socials, the Summer Games and the Annual Ball.', photo: 'Summer Games', href: '/events/' }
];
---

<Layout>
    <Hero image={site.heroImage} label="Annual Ball (wide shot)" tall>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/80">{site.displayName}</p>
        <h1 class="mt-4 max-w-3xl text-white">Supporting ACA students across Greater Manchester</h1>
        <p class="mt-5 max-w-xl text-lg text-white/85">{site.tagline}</p>
        <div class="mt-8 flex flex-wrap gap-3">
            <a href="/events/" class="btn-primary">View events</a>
            <a href="/sponsors/" class="btn-light">Sponsorship</a>
        </div>
    </Hero>


    <section id="how-we-help" class="section">
        <div class="container-site reveal">
            <p class="eyebrow">What we do</p>
            <h2 class="mt-3">How we help</h2>
            <div class="mt-10 grid gap-2 md:grid-cols-3">
                {
                    areas.map((a) => (
                        <a href={a.href} class="group relative block overflow-hidden">
                            <Photo alt={a.photo} class="aspect-[3/4]" />
                            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 to-transparent p-6 pt-20 text-white">
                                <span class="mb-3 block h-1 w-10 bg-accent-500 transition-all duration-500 group-hover:w-20"></span>
                                <h3 class="text-xl font-bold text-white">{a.title}</h3>
                                <p class="mt-1 text-sm text-white/85">{a.text}</p>
                            </div>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <section aria-labelledby="quick-links" class="border-y border-ink-100 bg-white">
        <div class="container-site flex flex-col gap-4 py-6 md:flex-row md:items-center md:gap-10">
            <h2 id="quick-links" class="shrink-0 text-xs font-semibold uppercase tracking-[0.2em] text-accent-500">Quick links</h2>
            <ul class="grid grid-cols-2 gap-x-6 gap-y-3 sm:grid-cols-3 md:flex md:flex-wrap md:gap-x-8">
                {
                    quickLinks.map((q) => (
                        <li>
                            <a href={q.href} class="group inline-flex items-center gap-1.5 text-sm font-semibold text-ink-900 transition-colors hover:text-accent-500">
                                <span class="link-underline">{q.title}</span>
                                <span class="text-accent-500 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-px" aria-hidden="true">{q.external ? '↗' : '→'}</span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>


    <section id="events" class="section">
        <div class="container-site reveal">
            <div class="flex flex-wrap items-end justify-between gap-4">
                <div>
                    <p class="eyebrow">Events</p>
                    <h2 class="mt-3">{showUpcoming ? 'Forthcoming events' : 'Recent events'}</h2>
                </div>
                <a href="/events/" class="text-xs font-bold uppercase tracking-[0.12em] text-ink-900 underline underline-offset-4">All events</a>
            </div>
            {
                eventList.length ? (
                    <div class="mt-10 grid gap-6 md:grid-cols-3">{eventList.map((e) => <EventCard event={e} />)}</div>
                ) : (
                    <p class="mt-8 text-stone-600">Forthcoming events will be published here.</p>
                )
            }
        </div>
    </section>

    <section id="photos" class="pb-14 sm:pb-20">
        <div class="container-site reveal">
            <p class="eyebrow">Gallery</p>
            <h2 class="mt-3">Moments from MCASS</h2>
            <div class="mt-10">
                <Gallery labels={['Annual Ball', 'Summer Games', 'Post-exam social', 'Revision session', 'Awards']} />
            </div>
        </div>
    </section>

    <section id="sponsors" class="border-t border-ink-100 bg-ink-50">
        <div class="container-site py-14">
            <div class="flex flex-wrap items-end justify-between gap-6">
                <div>
                    <p class="eyebrow">Our partners</p>
                    <h2 class="mt-3">Supported by</h2>
                </div>
                <a href="/sponsors/" class="btn-dark">Become a partner</a>
            </div>
            {
                sponsors.length ? (
                    <ul class="mt-10 flex flex-wrap items-center gap-10">
                        {sponsors.map((s) => (
                            <li>
                                <a href={s.data.website ?? '#'} class="block no-underline" title={s.data.name}>
                                    {s.data.logo ? <img src={s.data.logo} alt={s.data.name} class="h-12 w-auto" /> : <span class="font-bold">{s.data.name}</span>}
                                </a>
                            </li>
                        ))}
                    </ul>
                ) : (
                    <div class="mt-10 grid grid-cols-2 gap-2 md:grid-cols-4">
                        {['Headline Partner', 'Event Partner', 'Event Partner', 'Supporter'].map((t) => (
                            <div class="grid h-24 place-items-center bg-white text-xs uppercase tracking-[0.12em] text-stone-400">{t} logo</div>
                        ))}
                    </div>
                )
            }
        </div>
    </section>

    <section id="about-us" class="border-t border-ink-100 bg-white">
        <div class="grid lg:grid-cols-2">
            <Photo alt="Committee" label="Committee group photo" class="aspect-[4/3] lg:aspect-auto lg:h-full" />
            <div class="px-4 py-14 sm:px-12 lg:py-20">
                <p class="eyebrow">About MCASS</p>
                <h2 class="mt-3">Run by students, since {site.registeredSince}</h2>
                <p class="mt-5 max-w-lg leading-relaxed text-stone-600">MCASS supports ACA students across Greater Manchester through revision sessions, professional development and networking events, post-exam socials, sport and the Annual Ball.</p>
                <p class="mt-4 max-w-lg text-sm text-stone-500">Registered charity in England and Wales, number {site.charityNumber}.</p>
                <dl class="mt-8 grid max-w-lg grid-cols-2 gap-6">
                    {
                        site.stats.slice(0, 4).map((s) => (
                            <div class="flex flex-col border-t-4 border-accent-500 pt-3">
                                <dt class="order-2 text-xs uppercase tracking-[0.12em] text-stone-500">{s.label}</dt>
                                <dd class="text-2xl font-bold text-ink-900">{s.value}</dd>
                            </div>
                        ))
                    }
                </dl>
                <a href="/about/" class="btn-dark mt-10">About us</a>
            </div>
        </div>
    </section>
</Layout>
