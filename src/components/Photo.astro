---
// Shows the photo if one is set, otherwise a labelled placeholder
// so the committee can see which picture goes where.
interface Props {
    src?: string | null;
    alt: string;
    label?: string;
    class?: string;
}
const { src, alt, label, class: className = 'aspect-[4/3]' } = Astro.props;
---

{
    src ? (
        <img src={src} alt={alt} loading="lazy" class:list={['h-full w-full object-cover', className]} />
    ) : (
        <div
            role="img"
            aria-label={`Photo placeholder: ${label ?? alt}`}
            class:list={['flex flex-col items-center justify-center gap-1 bg-slate-100 p-4 text-center text-slate-500 outline outline-1 -outline-offset-8 outline-slate-300', className]}
        >
            <span class="text-[10px] font-semibold uppercase tracking-[0.2em]">Photo</span>
            <span class="text-sm">{label ?? alt}</span>
        </div>
    )
}
