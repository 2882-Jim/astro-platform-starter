---
// MCASS logo and ICAEW badge, both linking to our page on icaew.com.
// Each shows a small card on hover/focus saying exactly where the link goes.
// Facts in the card are only ones we can back up (charity register).
import Logo from './Logo.astro';
import site from '../data/site.json';
interface Props {
    tone?: 'dark' | 'light';
    showLogo?: boolean;
}
const { tone = 'dark', showLogo = true } = Astro.props;
const badge = tone === 'light' ? 'border-white/70 text-white hover:bg-white hover:text-ink-900' : 'border-ink-900 text-ink-900 hover:bg-ink-900 hover:text-white';
const cardPos = tone === 'light' ? 'bottom-full mb-3' : 'top-full mt-3';
---

<div class="flex items-center gap-4">
    {
        showLogo && (
            <span class="group/logo relative">
                <a href={site.icaewPageUrl} class="block transition-opacity hover:opacity-80" aria-label={`${site.displayName}: our page on icaew.com (opens icaew.com)`}>
                    <Logo kind="mcass" tone={tone} />
                </a>
                <span role="tooltip" class:list={['pointer-events-none absolute left-0 z-50 w-72 border-t-4 border-accent-500 bg-white p-4 text-left text-ink-900 opacity-0 shadow-2xl ring-1 ring-black/5 transition duration-200 group-hover/logo:opacity-100 group-focus-within/logo:opacity-100', cardPos]}>
                    <span class="block text-sm font-bold">{site.displayName}</span>
                    <span class="mt-2 block text-xs leading-relaxed text-stone-600">ICAEW student society for Greater Manchester.</span>
                    <span class="mt-1 block text-xs leading-relaxed text-stone-600">Registered charity {site.charityNumber}, registered in {site.registeredSince}.</span>
                    <span class="mt-3 block text-[10px] font-bold uppercase tracking-[0.12em] text-accent-500">Click to open our page on icaew.com ↗</span>
                </span>
            </span>
        )
    }
    {showLogo && <span class:list={['hidden h-8 w-px sm:block', tone === 'light' ? 'bg-white/20' : 'bg-ink-100']} />}
    <span class="group/badge relative">
        <a href={site.icaewPageUrl} class:list={['inline-flex h-8 items-center gap-1.5 border px-2.5 text-xs font-bold tracking-[0.15em] transition-colors duration-200', badge]}>
            ICAEW <span aria-hidden="true">↗</span>
            <span class="sr-only">: our page on icaew.com</span>
        </a>
        <span role="tooltip" class:list={['pointer-events-none absolute left-0 z-50 w-56 whitespace-normal border-t-4 border-accent-500 bg-white p-3 text-left text-ink-900 opacity-0 shadow-2xl ring-1 ring-black/5 transition duration-200 group-hover/badge:opacity-100 group-focus-within/badge:opacity-100', cardPos]}>
            <span class="block text-xs font-bold">Our page on icaew.com</span>
            <span class="mt-1 block text-[11px] text-stone-600">Manchester Student Society</span>
            <span class="mt-2 block text-[10px] font-bold uppercase tracking-[0.12em] text-accent-500">Opens icaew.com ↗</span>
        </span>
    </span>
</div>
