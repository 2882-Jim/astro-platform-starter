---
import type { CollectionEntry } from 'astro:content';
import Photo from './Photo.astro';
import { formatEventDate } from '../lib/format';

interface Props {
    event: CollectionEntry<'events'>;
}
const { event } = Astro.props;
const d = event.data;
---

<article class="card flex flex-col overflow-hidden p-0">
    <Photo src={d.image} alt={d.title} label={`${d.title} photo`} rounded="rounded-none" class="aspect-[16/9]" />
    <div class="flex grow flex-col p-6">
        <p class="eyebrow">{d.category}</p>
        <h3 class="mt-1"><a href={`/events/${event.slug}/`} class="no-underline hover:underline">{d.title}</a></h3>
        <p class="mt-1 text-sm font-medium text-slate-600">{formatEventDate(d.date, d.dateConfirmed)}</p>
        <p class="mt-3 grow text-sm text-slate-600">{d.summary}</p>
        <a href={`/events/${event.slug}/`} class="mt-4 text-sm font-semibold text-navy-600">Details →</a>
    </div>
</article>
