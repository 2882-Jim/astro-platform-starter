---
interface Props {
    trail: { label: string; href?: string }[];
}
const { trail } = Astro.props;
---

<nav aria-label="Breadcrumb" class="border-b border-ink-100 bg-ink-50">
    <ol class="container-site flex flex-wrap items-center gap-2 py-3 text-xs text-stone-500">
        <li><a href="/" class="hover:text-accent-500">Home</a></li>
        {
            trail.map((t) => (
                <li class="flex items-center gap-2">
                    <span aria-hidden="true">/</span>
                    {t.href ? <a href={t.href} class="hover:text-accent-500">{t.label}</a> : <span class="font-semibold text-ink-900" aria-current="page">{t.label}</span>}
                </li>
            ))
        }
    </ol>
</nav>
