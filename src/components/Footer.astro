---
import IcaewLinks from './IcaewLinks.astro';
import OfficialLink from './OfficialLink.astro';
import site from '../data/site.json';
import { tabs, quickLinks, instagram, instagramHandle } from '../data/nav';
import Logo from './Logo.astro';
import { mailingListHref } from '../lib/format';
const year = new Date().getFullYear();
---

<footer class="border-t-4 border-accent-500 bg-ink-900 text-stone-300">
    <div class="container-site grid gap-10 py-14 lg:grid-cols-[1fr_3fr]">
        <div>
            <a href={site.icaewPageUrl} class="inline-block transition-opacity hover:opacity-80" aria-label={`${site.displayName}: our page on icaew.com (opens icaew.com)`}>
                <Logo kind="mcass" tone="light" />
            </a>
            <p class="mt-4 text-sm leading-relaxed">{site.displayName}. {site.tagline}</p>
            <div class="mt-6"><IcaewLinks tone="light" showLogo={false} /></div>
        </div>
        <div class="grid gap-8 text-sm sm:grid-cols-4">
            <div>
                <p class="text-xs font-bold uppercase tracking-[0.15em] text-white">Pages</p>
                <ul class="mt-3 space-y-1.5">
                    {tabs.map((t) => <li><a href={t.href} class="hover:text-white hover:underline">{t.label}</a></li>)}
                    {instagram && <li><a href={instagram} class="hover:text-white hover:underline">Instagram @{instagramHandle} <span aria-hidden="true">↗</span></a></li>}
                </ul>
            </div>
            {
                quickLinks.map((g) => (
                    <div class="hidden sm:block">
                        <p class="text-xs font-bold uppercase tracking-[0.15em] text-white">{g.heading}</p>
                        <ul class="mt-3 space-y-1.5">
                            {g.links.map((l) => (
                                <li>
                                    <a href={l.href} class="hover:text-white hover:underline">
                                        {l.label} {l.external && <span aria-hidden="true">↗</span>}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </div>
    <div class="border-t border-white/10">
        <p class="container-site py-5 text-xs text-stone-400">
            © {year} {site.fullName}. Registered charity in England and Wales, number <a class="underline hover:text-white" href={site.charityRegisterUrl}>{site.charityNumber}</a>.
        </p>
    </div>
</footer>
