---
import site from '../data/site.json';
import nav from '../data/nav.json';
import Logo from './Logo.astro';
import { mailingListHref } from '../lib/format';
const year = new Date().getFullYear();
---

<footer class="border-t-4 border-accent-500 bg-ink-900 text-stone-300">
    <div class="container-site grid gap-10 py-14 md:grid-cols-4">
        <div>
            <Logo kind="mcass" tone="light" />
            <p class="mt-4 text-sm leading-relaxed">{site.displayName}. {site.tagline}</p>
            <div class="mt-6 flex items-center gap-3">
                <Logo kind="icaew" tone="light" size="sm" />
            </div>
        </div>
        <div class="text-sm">
            <p class="text-xs font-bold uppercase tracking-[0.15em] text-white">Site map</p>
            <ul class="mt-4 space-y-2">
                <li><a class="hover:text-white" href="/">Home</a></li>
                {nav.main.map((l) => <li><a class="hover:text-white" href={l.href}>{l.label}</a></li>)}
            </ul>
        </div>
        <div class="text-sm">
            <p class="text-xs font-bold uppercase tracking-[0.15em] text-white">Contact</p>
            <ul class="mt-4 space-y-2">
                <li><a class="underline hover:text-white" href={`mailto:${site.email}`}>{site.email}</a></li>
                {site.instagramUrl && <li><a class="underline hover:text-white" href={site.instagramUrl}>Instagram</a></li>}
                {site.linkedinUrl && <li><a class="underline hover:text-white" href={site.linkedinUrl}>LinkedIn</a></li>}
                <li><a class="underline hover:text-white" href={mailingListHref}>Join our mailing list</a></li>
            </ul>
        </div>
        <div class="text-sm">
            <p class="text-xs font-bold uppercase tracking-[0.15em] text-white">More</p>
            <ul class="mt-4 space-y-2">
                <li><a class="hover:text-white" href={site.icaewPageUrl}>MCASS on icaew.com</a></li>
                <li><a class="hover:text-white" href="/privacy/">Privacy notice</a></li>
            </ul>
        </div>
    </div>
    <div class="border-t border-white/10">
        <p class="container-site py-5 text-xs text-stone-400">
            © {year} {site.fullName}. Registered charity in England and Wales, number {site.charityNumber}.
        </p>
    </div>
</footer>
