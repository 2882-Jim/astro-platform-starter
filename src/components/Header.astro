---
import Logo from './Logo.astro';
import site from '../data/site.json';
import nav from '../data/nav.json';
const path = Astro.url.pathname;
const active = (href: string) => path.startsWith(href);
---

<div class="bg-accent-500 text-white">
    <div class="container-site flex h-9 items-center justify-between gap-4 text-xs">
        <p class="hidden truncate sm:block">ICAEW student society for Greater Manchester</p>
        <ul class="flex items-center gap-5">
            <li><a href={`mailto:${site.email}`} class="hover:underline">{site.email}</a></li>
            {site.instagramUrl && <li><a href={site.instagramUrl} class="hover:underline">Instagram</a></li>}
            <li><a href="/sponsors/" class="font-bold hover:underline">Sponsor us</a></li>
        </ul>
    </div>
</div>
<header class="sticky top-0 z-40 border-b border-ink-100 bg-white/95 backdrop-blur">
    <div class="container-site flex h-20 items-center justify-between gap-6">
        <a href="/" class="flex items-center gap-4" aria-label="MCASS home">
            <Logo kind="mcass" />
            <span class="hidden h-8 w-px bg-ink-100 sm:block"></span>
            <span class="hidden items-center gap-2 sm:flex">
                <Logo kind="icaew" size="sm" />
                <Logo kind="aca" size="sm" />
            </span>
        </a>
        <nav aria-label="Main" class="hidden lg:block">
            <ul class="flex items-center gap-7 text-sm font-medium">
                {
                    nav.main.map((l) => (
                        <li>
                            <a
                                href={l.href}
                                class:list={['link-underline py-1', active(l.href) ? 'bg-[length:100%_2px] text-accent-500' : 'text-ink-700 hover:text-accent-500']}
                                aria-current={active(l.href) ? 'page' : undefined}
                            >
                                {l.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
        <details class="group relative lg:hidden">
            <summary class="cursor-pointer list-none bg-accent-500 px-4 py-2 text-xs font-bold uppercase tracking-widest text-white">Menu</summary>
            <ul class="absolute right-0 mt-2 w-64 border-t-4 border-accent-500 bg-white py-2 shadow-xl">
                {
                    nav.main.map((l) => (
                        <li>
                            <a href={l.href} class:list={['block px-5 py-3 text-sm hover:bg-ink-50', active(l.href) && 'font-bold text-accent-500']}>
                                {l.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </details>
    </div>
</header>
