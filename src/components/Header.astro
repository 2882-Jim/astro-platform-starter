---
import Logo from './Logo.astro';
const links = [
    { href: '/about/', label: 'About' },
    { href: '/events/', label: 'Events' },
    { href: '/sponsors/', label: 'Sponsorship' },
    { href: '/join/', label: 'Membership' },
    { href: '/contact/', label: 'Contact' }
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white">
    <div class="container-site flex h-20 items-center justify-between gap-6">
        <a href="/" class="flex items-center gap-4 no-underline" aria-label="MCASS home">
            <Logo kind="mcass" />
            <span class="hidden h-8 w-px bg-slate-300 sm:block"></span>
            <span class="hidden items-center gap-2 sm:flex">
                <Logo kind="icaew" size="sm" />
                <Logo kind="aca" size="sm" />
            </span>
        </a>
        <nav aria-label="Main" class="hidden lg:block">
            <ul class="flex items-center gap-8 text-sm">
                {
                    links.map((l) => (
                        <li>
                            <a
                                href={l.href}
                                class:list={[
                                    'border-b-2 py-1 no-underline hover:border-navy-900',
                                    path.startsWith(l.href) ? 'border-accent-500 text-navy-900' : 'border-transparent text-slate-600'
                                ]}
                                aria-current={path.startsWith(l.href) ? 'page' : undefined}
                            >
                                {l.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
        <details class="relative lg:hidden">
            <summary class="cursor-pointer list-none border border-slate-300 px-3 py-2 text-xs font-semibold uppercase tracking-widest">Menu</summary>
            <ul class="absolute right-0 mt-2 w-56 border border-slate-200 bg-white py-2 shadow-lg">
                {
                    links.map((l) => (
                        <li>
                            <a href={l.href} class="block px-4 py-2 text-sm no-underline hover:bg-navy-50">
                                {l.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </details>
    </div>
</header>
