---
import IcaewLinks from './IcaewLinks.astro';
import site from '../data/site.json';
import { tabs, quickLinks, instagram, instagramHandle } from '../data/nav';
const path = Astro.url.pathname;
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<div class="hidden bg-accent-500 text-white md:block">
    <div class="container-site flex h-8 items-center text-xs">
        <p class="truncate">{site.displayName}</p>
    </div>
</div>
<header class="sticky top-0 z-40 border-b border-ink-100 bg-white/95 backdrop-blur">
    <div class="container-site relative flex h-20 items-center justify-between gap-6">
        <IcaewLinks />

        <nav aria-label="Main" class="hidden xl:block">
            <ul class="flex items-center gap-6 text-sm font-medium">
                <li>
                    <details class="quick-links group/ql relative">
                        <summary class="flex cursor-pointer list-none items-center gap-1.5 bg-accent-500 px-3 py-2 text-xs font-bold uppercase tracking-[0.12em] text-white transition-opacity hover:opacity-90">
                            Quick links
                            <span class="text-[8px] transition-transform duration-200 group-open/ql:rotate-180" aria-hidden="true">▼</span>
                        </summary>
                        <div class="absolute left-0 top-full z-50 mt-3 grid w-[40rem] grid-cols-3 gap-6 border-t-4 border-accent-500 bg-white p-6 shadow-xl ring-1 ring-black/5">
                            {
                                quickLinks.map((g) => (
                                    <div>
                                        <p class="text-[10px] font-bold uppercase tracking-[0.15em] text-stone-500">{g.heading}</p>
                                        <ul class="mt-3 space-y-2">
                                            {g.links.map((l) => (
                                                <li>
                                                    <a href={l.href} class="group/l flex items-center justify-between gap-2 text-sm text-ink-900 hover:text-accent-500">
                                                        <span>{l.label}</span>
                                                        <span class="text-xs text-accent-500 transition-transform group-hover/l:translate-x-0.5" aria-hidden="true">{l.external ? '↗' : '→'}</span>
                                                    </a>
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                ))
                            }
                        </div>
                    </details>
                </li>
                {
                    tabs.map((t) => (
                        <li>
                            <a
                                href={t.href}
                                class:list={['link-underline py-1', active(t.href) ? 'bg-[length:100%_2px] text-accent-500' : 'text-ink-700 hover:text-accent-500']}
                                aria-current={active(t.href) ? 'page' : undefined}
                            >
                                {t.label}
                            </a>
                        </li>
                    ))
                }
                {
                    instagram && (
                        <li>
                            <a href={instagram} class="group inline-flex items-center gap-1.5 text-ink-700 hover:text-accent-500" aria-label={`Instagram (@${instagramHandle})`}>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4 transition-transform duration-300 group-hover:scale-110" aria-hidden="true">
                                    <rect x="3" y="3" width="18" height="18" rx="5" />
                                    <circle cx="12" cy="12" r="4" />
                                    <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                                </svg>
                                <span class="link-underline">Instagram</span>
                            </a>
                        </li>
                    )
                }
            </ul>
        </nav>

        {/* Phone and tablet menu */}
        <details class="group/menu xl:hidden">
            <summary class="cursor-pointer list-none bg-accent-500 px-4 py-2 text-xs font-bold uppercase tracking-widest text-white">
                <span class="group-open/menu:hidden">Menu</span><span class="hidden group-open/menu:inline">Close</span>
            </summary>
            <div class="absolute inset-x-0 top-full max-h-[80vh] overflow-y-auto border-t-4 border-accent-500 bg-white shadow-xl">
                <details class="group/sub border-b border-ink-100 bg-ink-50">
                    <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4 text-base font-bold text-accent-500">
                        Quick links
                        <span class="text-xs transition-transform duration-200 group-open/sub:rotate-180" aria-hidden="true">▼</span>
                    </summary>
                    <div class="space-y-4 px-5 pb-4">
                        {
                            quickLinks.map((g) => (
                                <div>
                                    <p class="text-[10px] font-bold uppercase tracking-[0.15em] text-stone-500">{g.heading}</p>
                                    <ul class="mt-1">
                                        {g.links.map((l) => (
                                            <li>
                                                <a href={l.href} class="block py-2 text-sm text-ink-900">
                                                    {l.label} <span class="text-accent-500" aria-hidden="true">{l.external ? '↗' : ''}</span>
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            ))
                        }
                    </div>
                </details>
                {
                    tabs.map((t) => (
                        <a href={t.href} class:list={['block border-b border-ink-100 px-5 py-4 text-base font-bold', active(t.href) ? 'text-accent-500' : 'text-ink-900']}>
                            {t.label}
                        </a>
                    ))
                }
                {
                    instagram && (
                        <a href={instagram} class="flex items-center gap-2 px-5 py-4 text-base font-bold text-ink-900">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5" aria-hidden="true">
                                <rect x="3" y="3" width="18" height="18" rx="5" />
                                <circle cx="12" cy="12" r="4" />
                                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                            </svg>
                            Instagram <span class="font-normal text-stone-500">@{instagramHandle}</span>
                        </a>
                    )
                }
            </div>
        </details>
    </div>
</header>
<script>
    // Close the Quick links dropdown when clicking anywhere else.
    function setupQuickLinks() {
        const dd = document.querySelector<HTMLDetailsElement>('details.quick-links');
        if (!dd) return;
        document.addEventListener('click', (e) => {
            if (dd.open && !dd.contains(e.target as Node)) dd.open = false;
        });
    }
    document.addEventListener('astro:page-load', setupQuickLinks);
</script>
