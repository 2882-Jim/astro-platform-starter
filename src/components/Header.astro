---
import site from '../data/site.json';
const links = [
    { href: '/about/', label: 'About' },
    { href: '/events/', label: 'Events' },
    { href: '/sponsors/', label: 'Partner with us' },
    { href: '/join/', label: 'Join' },
    { href: '/contact/', label: 'Contact' }
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-navy-900 text-white">
    <div class="container-site flex h-16 items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-extrabold tracking-tight no-underline">
            <span class="grid h-8 w-8 place-items-center rounded-lg bg-gold-400 text-sm text-navy-900">M</span>
            <span class="text-lg">{site.shortName}</span>
        </a>
        <nav aria-label="Main" class="hidden md:block">
            <ul class="flex items-center gap-6 text-sm font-medium">
                {
                    links.map((l) => (
                        <li>
                            <a
                                href={l.href}
                                class:list={['no-underline hover:text-gold-300', path.startsWith(l.href) && 'text-gold-300']}
                                aria-current={path.startsWith(l.href) ? 'page' : undefined}
                            >
                                {l.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
        <details class="relative md:hidden">
            <summary class="cursor-pointer list-none rounded-lg px-3 py-2 text-sm font-semibold ring-1 ring-white/30">Menu</summary>
            <ul class="absolute right-0 mt-2 w-56 rounded-xl bg-white p-2 text-navy-900 shadow-lg">
                {
                    links.map((l) => (
                        <li>
                            <a href={l.href} class="block rounded-lg px-3 py-2 no-underline hover:bg-navy-50">
                                {l.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </details>
    </div>
</header>
